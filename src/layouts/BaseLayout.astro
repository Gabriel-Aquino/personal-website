---
import BaseHead from "../components/BaseHead.astro";
import SidebarLeft from "../components/SidebarLeft.astro";
import SidebarRight from "../components/SidebarRight.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  ignoreSearch?: boolean;
  showRightSidebar?: boolean;
}

const { title, description, image, ignoreSearch = false, showRightSidebar = true } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="antialiased">
  <head>
    <BaseHead title={title} description={description} image={image} />

    <!-- Espaço reservado para o script do Google AdSense -->
    <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXX" crossorigin="anonymous"></script> -->
  </head>
  <body
    class="flex flex-col min-h-screen bg-white dark:bg-[#0A0A0A] text-zinc-900 dark:text-zinc-100 selection:bg-brand-primary/30"
    {...ignoreSearch ? { "data-pagefind-ignore": "all" } : {}}
  >
    <SidebarLeft />
    
    <div class="flex-1 lg:ml-64 flex flex-col min-w-0 min-h-screen">
      <main class="flex-grow w-full px-4 sm:px-6 lg:px-8 py-8 md:py-12">
        <div class="flex flex-col xl:flex-row gap-8 xl:gap-12 relative w-full h-full">
          <div class="flex-1 min-w-0 w-full">
            <slot />
          </div>
          {showRightSidebar && (
            <aside class="hidden xl:block w-80 flex-shrink-0 relative">
              <SidebarRight />
            </aside>
          )}
        </div>
      </main>
      <Footer />
    </div>
    <CookieBanner />
  </body>
</html>
