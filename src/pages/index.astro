---
import BaseLayout from "../layouts/BaseLayout.astro";
import { BlogService } from "../services/BlogService";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PostCard from "../components/PostCard.astro";
import NavbarSearch from "../components/NavbarSearch.astro";

const posts = await BlogService.getAllPosts();
const tags = await BlogService.getAllTags();
const featuredPosts = await BlogService.getFeaturedPosts();
const categories = await BlogService.getAllCategories();

const latestPosts = posts.slice(0, 5);
const heroPost = latestPosts[0];
const stackedPosts = latestPosts.slice(1);
const filterablePosts = posts;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="flex flex-col xl:flex-row gap-8 xl:gap-12 relative w-full h-full">
    
    <!-- Left Column: Main Content -->
    <div class="flex-1 min-w-0 w-full">
      
      <!-- Mobile Search placeholder -->
      <div class="hidden"></div>

      <section class="w-full space-y-16">
        
        <!-- SECTION 1: Últimas Postagens -->
        {latestPosts.length > 0 && (
          <div class="w-full">
            <h2 class="text-2xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 border-b border-zinc-200 dark:border-zinc-800/50 pb-4 w-full">
              Últimas postagens
            </h2>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 w-full">
              {heroPost && (
                <div class="lg:col-span-2">
                  <PostCard post={heroPost} isHero={true} />
                </div>
              )}
              {stackedPosts.length > 0 && (
                <div class="flex flex-col gap-3">
                  {stackedPosts.map((post) => (
                    <PostCard post={post} isCompact={true} />
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        <!-- SECTION 2 (Mobile Only): Destaques -->
        {featuredPosts.length > 0 && (
          <div class="block xl:hidden w-full">
            <h2 class="text-2xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 border-b border-zinc-200 dark:border-zinc-800/50 pb-4 flex items-center gap-2">
              <svg
                class="w-6 h-6 text-brand-primary"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              Destaques
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full">
              {featuredPosts.slice(0, 4).map((post) => (
                <PostCard post={post} isCompact={true} />
              ))}
            </div>
          </div>
        )}

        <!-- SECTION 3: Postagens (Filterable) -->
        <div class="w-full">
          <h2 class="text-2xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 mb-6 border-b border-zinc-200 dark:border-zinc-800/50 pb-4 w-full">
            Postagens
          </h2>
          
          <!-- Search & Filters Block -->
          <div class="mb-8 w-full bg-zinc-50 dark:bg-zinc-800/30 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800/50">
            <div class="mb-6 xl:hidden">
              <NavbarSearch />
            </div>
            
            <div class="flex flex-col gap-6">
              <!-- Categories -->
              <div>
                <h3 class="text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Categorias</h3>
                <div class="flex gap-4 overflow-x-auto pb-2 custom-scrollbar w-full">
                  <button
                    data-category="all"
                    class="category-btn pb-2 border-b-2 font-bold whitespace-nowrap px-2 transition-colors text-brand-primary border-brand-primary"
                  >
                    Todos
                  </button>
                  {
                    categories.map((cat) => (
                      <button
                        data-category={cat}
                        class="category-btn pb-2 border-b-2 font-bold whitespace-nowrap px-2 transition-colors border-transparent text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-300 dark:hover:border-zinc-700"
                      >
                        {cat}
                      </button>
                    ))
                  }
                </div>
              </div>

              <!-- Tags -->
              <div>
                <h3 class="text-xs font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-3">Assuntos</h3>
                <div class="flex flex-nowrap gap-2 overflow-x-auto pb-4 custom-scrollbar w-full">
                  <button data-tag="all" class="tag-btn uppercase tracking-wider text-[10px] font-bold text-brand-primary px-3 py-1.5 bg-brand-primary/10 border border-brand-primary/20 rounded-full transition-all shadow-sm shrink-0">Todos</button>
                  {tags.map(tag => (
                    <button data-tag={tag} class="tag-btn uppercase tracking-wider text-[10px] font-bold text-zinc-600 dark:text-zinc-400 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/50 rounded-full hover:bg-brand-primary hover:text-white dark:hover:bg-brand-primary dark:hover:text-white hover:border-brand-primary dark:hover:border-brand-primary transition-all shadow-sm shrink-0">{tag}</button>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div
            id="posts-container"
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-4 gap-8 xl:gap-6 w-full"
          >
            {
              filterablePosts.map((post) => (
                <PostCard post={post} withDataAttributes={true} />
              ))
            }
          </div>

          {
            filterablePosts.length === 0 && (
              <p class="text-zinc-500 dark:text-zinc-400 italic mt-8">
                Nenhuma postagem publicada ainda.
              </p>
            )
          }

          <p
            id="empty-state"
            class="hidden text-zinc-500 dark:text-zinc-400 italic mt-8"
          >
            Nenhuma postagem encontrada para este filtro.
          </p>
        </div>
      </section>
    </div>

    <!-- Right Sidebar (Desktop only) -->
    <aside class="hidden xl:block w-80 flex-shrink-0 relative">
      <div class="sticky top-8 space-y-8 z-40">
        <NavbarSearch />
        
        {featuredPosts.length > 0 && (
          <div class="w-full">
            <h2 class="text-sm font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-4 flex items-center gap-2">
              <svg
                class="w-4 h-4 text-brand-primary"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
              Destaques
            </h2>
            <div class="flex flex-col gap-4">
              {featuredPosts.slice(0, 4).map((post) => (
                <PostCard post={post} isCompact={true} />
              ))}
            </div>
          </div>
        )}
      </div>
    </aside>

  </div>
</BaseLayout>

<script>
  const initFilters = () => {
    const categoryBtns = document.querySelectorAll(".category-btn");
    const tagBtns = document.querySelectorAll(".tag-btn");
    // Only filter cards inside the #posts-container
    const postCards = document.querySelectorAll("#posts-container .post-card");
    const emptyState = document.getElementById("empty-state");

    let activeCategory = "all";
    let activeTag = "all";
    let tagSearchQuery = "";

    function updatePosts() {
      let visibleCount = 0;

      postCards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        const tags = card.getAttribute("data-tags")?.split(",") || [];

        const matchCategory =
          activeCategory === "all" || cat === activeCategory;
        const matchTag = activeTag === "all" || tags.includes(activeTag);

        if (matchCategory && matchTag) {
          (card as HTMLElement).style.display = "flex";
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
        }
      }
    }

    function updateTags() {
      // Dynamic cascading: find all tags belonging to posts in the active category
      const allowedTags = new Set<string>();
      postCards.forEach((card) => {
        const cat = card.getAttribute("data-category");
        if (activeCategory === "all" || cat === activeCategory) {
          const cardTags = card.getAttribute("data-tags")?.split(",") || [];
          cardTags.forEach((t) => {
            if (t) allowedTags.add(t.toLowerCase().trim());
          });
        }
      });

      let activeTagStillVisible = activeTag === "all";

      tagBtns.forEach((btn) => {
        const tag = btn.getAttribute("data-tag");
        if (!tag || tag === "all") return;

        const tagClean = tag.toLowerCase().trim();
        const matchesCategory = allowedTags.has(tagClean);
        const matchesSearch = tagClean.includes(tagSearchQuery);

        if (matchesCategory && matchesSearch) {
          (btn as HTMLElement).style.display = "inline-flex";
          if (activeTag === tag) {
            activeTagStillVisible = true;
          }
        } else {
          (btn as HTMLElement).style.display = "none";
        }
      });

      // If active tag was filtered out, reset active tag to "all"
      if (!activeTagStillVisible) {
        activeTag = "all";
        tagBtns.forEach((b) => {
          const t = b.getAttribute("data-tag");
          if (t === "all") {
            b.classList.add(
              "text-brand-primary",
              "bg-brand-primary/10",
              "border-brand-primary/20",
            );
            b.classList.remove(
              "bg-zinc-100",
              "dark:bg-zinc-800/50",
              "text-zinc-600",
              "dark:text-zinc-400",
              "border-zinc-200",
              "dark:border-zinc-700/50",
            );
          } else {
            b.classList.remove(
              "text-brand-primary",
              "bg-brand-primary/10",
              "border-brand-primary/20",
            );
            b.classList.add(
              "bg-zinc-100",
              "dark:bg-zinc-800/50",
              "text-zinc-600",
              "dark:text-zinc-400",
              "border-zinc-200",
              "dark:border-zinc-700/50",
            );
          }
        });
        updatePosts();
      }
    }

    // Listen to globalSearchInput custom event emitted by NavbarSearch
    window.addEventListener('globalSearchInput', (e: any) => {
      tagSearchQuery = e.detail?.query || "";
      updateTags();
    });

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeCategory = btn.getAttribute("data-category") || "all";

        // Update button styles
        categoryBtns.forEach((b) => {
          b.classList.remove("text-brand-primary", "border-brand-primary");
          b.classList.add(
            "border-transparent",
            "text-zinc-500",
            "dark:text-zinc-400",
            "hover:text-zinc-900",
            "dark:hover:text-zinc-100",
            "hover:border-zinc-300",
            "dark:hover:border-zinc-700"
          );
        });
        btn.classList.add("text-brand-primary", "border-brand-primary");
        btn.classList.remove(
          "border-transparent",
          "text-zinc-500",
          "dark:text-zinc-400",
          "hover:text-zinc-900",
          "dark:hover:text-zinc-100",
          "hover:border-zinc-300",
          "dark:hover:border-zinc-700"
        );

        // Reset tag search on category change for better UX
        tagSearchQuery = "";
        const inputs = document.querySelectorAll(".search-input");
        inputs.forEach(input => {
          (input as HTMLInputElement).value = "";
        });

        updateTags();
        updatePosts();
      });
    });

    tagBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeTag = btn.getAttribute("data-tag") || "all";

        // Update button styles for ALL tag buttons (mobile and desktop)
        tagBtns.forEach((b) => {
          b.classList.remove(
            "text-brand-primary",
            "bg-brand-primary/10",
            "border-brand-primary/20",
          );
          b.classList.add(
            "bg-zinc-100",
            "dark:bg-zinc-800/50",
            "text-zinc-600",
            "dark:text-zinc-400",
            "border-zinc-200",
            "dark:border-zinc-700/50",
          );
        });

        // Now activate the selected ones
        const selectedBtns = document.querySelectorAll(`.tag-btn[data-tag="${activeTag}"]`);
        selectedBtns.forEach((b) => {
          b.classList.add(
            "text-brand-primary",
            "bg-brand-primary/10",
            "border-brand-primary/20",
          );
          b.classList.remove(
            "bg-zinc-100",
            "dark:bg-zinc-800/50",
            "text-zinc-600",
            "dark:text-zinc-400",
            "border-zinc-200",
            "dark:border-zinc-700/50",
          );
        });

        updatePosts();
      });
    });

    // Initial setup
    updateTags();
    updatePosts();
  };

  document.addEventListener("astro:page-load", () => {
    if (document.getElementById("posts-container")) {
      initFilters();
    }
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 6px;
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #d4d4d8;
    border-radius: 10px;
  }
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #3f3f46;
  }
</style>
