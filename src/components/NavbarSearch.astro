---
// src/components/NavbarSearch.astro
---

<div
  class="relative w-full group z-[100] navbar-search-container"
>
  <!-- Search Input Trigger -->
  <div class="relative flex items-center w-full">
    <svg
      class="absolute left-3 w-4 h-4 text-zinc-500"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <input
      type="text"
      placeholder="Buscar posts, projetos, tags..."
      class="search-input w-full bg-zinc-100 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/50 text-zinc-900 dark:text-zinc-100 rounded-lg pl-9 pr-14 py-2.5 text-sm font-medium transition-all duration-200 focus:outline-none focus:border-brand-primary focus:ring-1 focus:ring-brand-primary placeholder:text-zinc-500 cursor-text"
      autocomplete="off"
    />
    <div class="absolute right-2 flex items-center">
      <kbd
        class="os-key hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-500 dark:text-zinc-400 pointer-events-none"
      >
        <span>⌘</span>K
      </kbd>
    </div>
  </div>

  <!-- Search Results Drawer -->
  <div
    class="search-drawer absolute top-full left-0 right-0 mt-2 w-full max-h-[60vh] overflow-y-auto bg-white dark:bg-brand-surface border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-2xl opacity-0 invisible transition-all duration-200 origin-top transform scale-95"
  >
    <div class="p-4 search-results">
      <p class="text-sm text-zinc-500 dark:text-zinc-400 text-center py-4">
        Digite para buscar...
      </p>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    title: string;
    description: string;
    tags: string[];
    url: string;
    type: string;
  }

  let searchData: SearchItem[] = [];
  let isFetching = false;
  let isMac = false;

  if (typeof window !== "undefined") {
    isMac = navigator.platform.toUpperCase().indexOf("MAC") >= 0;

    document.addEventListener("keydown", (e) => {
      const drawers = document.querySelectorAll(".search-drawer");
      let anyOpen = false;
      drawers.forEach((drawer) => {
        if (!drawer.classList.contains("opacity-0")) anyOpen = true;
      });

      if ((isMac ? e.metaKey : e.ctrlKey) && e.key === "k") {
        e.preventDefault();
        // Open the first visible search input
        const containers = document.querySelectorAll(".navbar-search-container");
        for (const container of containers) {
          if (window.getComputedStyle(container).display !== "none") {
            openSearch(container as HTMLElement);
            break;
          }
        }
      }
      if (e.key === "Escape" && anyOpen) {
        closeAllSearches();
      }
    });

    document.addEventListener("click", (e) => {
      let clickedInside = false;
      document.querySelectorAll(".navbar-search-container").forEach((container) => {
        if (container.contains(e.target as Node)) {
          clickedInside = true;
        }
      });
      if (!clickedInside) {
        closeAllSearches();
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    const containers = document.querySelectorAll(".navbar-search-container");
    
    containers.forEach(container => {
      const input = container.querySelector(".search-input") as HTMLInputElement;
      const shortcutKey = container.querySelector(".os-key span");
      
      if (shortcutKey) shortcutKey.textContent = isMac ? "⌘" : "Ctrl";

      if (input) {
        input.addEventListener("focus", () => openSearch(container as HTMLElement));
        input.addEventListener("input", (e) => {
          const query = (e.target as HTMLInputElement).value.toLowerCase();
          renderResults(container as HTMLElement, query);
          
          // Disparar evento customizado para que o index.astro possa filtrar as tags
          const event = new CustomEvent('globalSearchInput', { detail: { query } });
          window.dispatchEvent(event);
        });
      }
    });
  });

  async function openSearch(container: HTMLElement) {
    const input = container.querySelector(".search-input") as HTMLInputElement;
    const drawer = container.querySelector(".search-drawer");
    const resultsDiv = container.querySelector(".search-results");

    if (!drawer || !input) return;

    drawer.classList.remove("opacity-0", "invisible", "scale-95");
    drawer.classList.add("opacity-100", "visible", "scale-100");
    
    // Close other drawers
    document.querySelectorAll(".navbar-search-container").forEach(c => {
      if (c !== container) {
        const d = c.querySelector(".search-drawer");
        d?.classList.add("opacity-0", "invisible", "scale-95");
        d?.classList.remove("opacity-100", "visible", "scale-100");
      }
    });

    if (searchData.length === 0 && !isFetching) {
      isFetching = true;
      if (resultsDiv)
        resultsDiv.innerHTML =
          '<div class="flex justify-center py-4"><div class="w-5 h-5 border-2 border-brand-primary border-t-transparent rounded-full animate-spin"></div></div>';

      try {
        const res = await fetch("/api/search.json");
        searchData = await res.json();
        renderResults(container, input.value.toLowerCase() || "");
      } catch {
        if (resultsDiv)
          resultsDiv.innerHTML =
            '<p class="text-sm text-red-500 text-center py-4">Erro ao carregar dados de busca.</p>';
      } finally {
        isFetching = false;
      }
    } else {
      renderResults(container, input.value.toLowerCase() || "");
    }
  }

  function closeAllSearches() {
    document.querySelectorAll(".navbar-search-container").forEach(container => {
      const input = container.querySelector(".search-input") as HTMLInputElement;
      const drawer = container.querySelector(".search-drawer");
      
      if (drawer) {
        drawer.classList.remove("opacity-100", "visible", "scale-100");
        drawer.classList.add("opacity-0", "invisible", "scale-95");
      }
      if (input) input.blur();
    });
  }

  function renderResults(container: HTMLElement, query: string) {
    const resultsDiv = container.querySelector(".search-results");
    if (!resultsDiv) return;

    if (!query.trim()) {
      resultsDiv.innerHTML =
        '<p class="text-sm text-zinc-500 dark:text-zinc-400 text-center py-4">Digite para buscar postagens e projetos...</p>';
      return;
    }

    const filtered = searchData.filter(
      (item: SearchItem) =>
        item.title.toLowerCase().includes(query) ||
        item.description.toLowerCase().includes(query) ||
        item.tags.some((tag: string) => tag.toLowerCase().includes(query)),
    );

    if (filtered.length === 0) {
      resultsDiv.innerHTML =
        '<p class="text-sm text-zinc-500 dark:text-zinc-400 text-center py-4">Nenhum resultado encontrado.</p>';
      return;
    }

    resultsDiv.innerHTML = filtered
      .map(
        (item: SearchItem) => `
      <a href="${escapeHTML(item.url)}" class="block py-3 px-2 border-b border-zinc-100 dark:border-zinc-800 last:border-0 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 rounded-lg transition-colors group">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] uppercase font-bold tracking-wider text-brand-primary bg-brand-primary/10 px-2 py-0.5 rounded">${escapeHTML(item.type)}</span>
          <h4 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-primary transition-colors line-clamp-1">${highlight(escapeHTML(item.title), query)}</h4>
        </div>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-1">${escapeHTML(item.description)}</p>
      </a>
    `,
      )
      .join("");
  }

  function escapeHTML(str: string) {
    if (!str) return "";
    return str.replace(/[&<>'"]/g, 
      tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
    );
  }

  function highlight(text: string, query: string) {
    if (!query) return text;
    const regex = new RegExp(`(${query})`, "gi");
    return text.replace(
      regex,
      '<mark class="bg-brand-primary/20 text-brand-primary rounded px-0.5 text-inherit">$1</mark>',
    );
  }
</script>
