---
import { Image } from "astro:assets";
import { slugifyCategory } from "../utils/url";
import FormattedDate from "./FormattedDate.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  isHero?: boolean;
  isCompact?: boolean;
  withDataAttributes?: boolean;
}

const { post, isHero = false, isCompact = false, withDataAttributes = false } = Astro.props;
const category = post.data.category || "Geral";
const tags = post.data.tags ? post.data.tags.join(",") : "";
---

<article
  class={`post-card group relative flex ${isCompact ? "flex-row items-center p-2.5 gap-3" : "flex-col justify-between p-5 h-full"} rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-brand-surface shadow-sm hover:shadow-md transition-shadow`}
  data-category={withDataAttributes ? category : undefined}
  data-tags={withDataAttributes ? tags : undefined}
>
  {isCompact ? (
    <>
      {post.data.coverImage && (
        <div class="w-16 h-16 sm:w-24 sm:h-24 flex-shrink-0 overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800 relative transition-all">
          {typeof post.data.coverImage === "string" ? (
            <img
              src={post.data.coverImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          ) : (
             <Image
              src={post.data.coverImage}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          )}
        </div>
      )}
      <div class="flex-1 min-w-0 flex flex-col justify-center">
        <div class="flex items-center gap-2 text-[11px] text-zinc-500 dark:text-zinc-400 mb-1 font-medium">
          <FormattedDate date={post.data.pubDate} />
        </div>
        <h3 class="post-title text-sm sm:text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-primary transition-colors line-clamp-2 leading-snug">
          <a href={`/blog/${slugifyCategory(category)}/${post.id}`}>
            <span class="absolute inset-0 z-20" />
            {post.data.title}
          </a>
        </h3>
      </div>
    </>
  ) : (
    <>
      <div class="flex-1 flex flex-col">
        {
          post.data.coverImage && (
            <div class={`img-container ${isHero ? "aspect-video lg:aspect-[32/9] xl:aspect-[32/9]" : "aspect-video"} w-full mb-4 overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800 relative transition-all`}>
              {typeof post.data.coverImage === "string" ? (
                <img
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={post.data.coverImage}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              )}
            </div>
          )
        }
        <div class="flex items-center gap-3 text-xs text-zinc-500 dark:text-zinc-400 mb-3 font-medium">
          <FormattedDate date={post.data.pubDate} />
          {
            post.data.category && (
              <>
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-300 dark:bg-zinc-700" />
                <span class="uppercase tracking-wider text-[10px] font-bold text-brand-accent px-2 py-0.5 bg-brand-accent/10 border border-brand-accent/20 rounded-full">
                  {post.data.category}
                </span>
              </>
            )
          }
        </div>

        <h3
          class={`post-title ${isHero ? "text-xl md:text-3xl" : "text-lg"} font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-primary transition-colors line-clamp-2`}
        >
          <a href={`/blog/${slugifyCategory(category)}/${post.id}`}>
            <span class="absolute inset-0 z-20" />
            {post.data.title}
          </a>
        </h3>

        {
          post.data.description && (
            <p
              class={`post-desc mt-3 text-zinc-600 dark:text-zinc-400 leading-relaxed ${isHero ? "text-sm md:text-base line-clamp-2" : "text-sm line-clamp-2"} transition-all`}
            >
              {post.data.description}
            </p>
          )
        }
      </div>

      <div class="mt-4 flex items-center text-sm font-bold text-brand-primary group-hover:text-brand-accent transition-colors">
        Ler post
        <svg
          class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </div>
    </>
  )}
</article>
